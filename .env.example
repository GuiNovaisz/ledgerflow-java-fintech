# Copy with scripts/New-LocalEnvironment.ps1 to create cryptographically random values.
POSTGRES_PASSWORD=replace-with-a-random-secret
JWT_SECRET=replace-with-base64-encoded-random-key-at-least-32-bytes
APP_PORT=8080
WEB_PORT=8081
DB_PORT=5432
# Set true only behind HTTPS. Local HTTP development uses false.
SESSION_COOKIE_SECURE=false
